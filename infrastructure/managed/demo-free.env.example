# Public values. Keep real secrets in Render/Vercel or the operator secret store.
FLOWMIND_DEPLOYMENT_PROFILE=demo-free
FLOWMIND_AI_MODE=embedded-fake
FLOWMIND_EMAIL_MODE=embedded-fake
FLOWMIND_RENDER_PLAN=free
FLOWMIND_RENDER_REGION=ohio
FLOWMIND_VERCEL_PLAN=hobby
FLOWMIND_RENDER_SERVICE_ID=srv-replace-with-existing-service-id
FLOWMIND_VERCEL_PROJECT=flowmind-demo
FLOWMIND_DEPLOY_GIT_SHA=replace-with-reviewed-git-sha
FLOWMIND_MEMORY_GATE_APPROVED_SHA=replace-with-reviewed-git-sha
FLOWMIND_API_ORIGIN=https://replace-me.onrender.com
NEXT_PUBLIC_API_URL=https://replace-me.vercel.app/api
NEXT_PUBLIC_FLOWMIND_DEMO_FREE=true

# Render runtime. Set these in the service; do not set RENDER_API_KEY there.
# For local gates, put only DATABASE_URL and REDIS_URL in
# ~/.config/flowmind/demo-free.env with mode 600. Never copy real values here.
NODE_ENV=production
PORT=3001
NODE_OPTIONS=--max-old-space-size=256
DATABASE_URL=postgresql://role:password@host/database?sslmode=require&connect_timeout=15&connection_limit=3
REDIS_URL=rediss://default:password@host:6379
CORS_ORIGIN=https://replace-me.vercel.app
PUBLIC_APP_URL=https://replace-me.vercel.app
PUBLIC_API_URL=https://replace-me.vercel.app/api
AUTH_ORIGIN_REQUIRED=true
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_PATH=/api/auth
DEMO_REGISTRATION_ENABLED=false
BULLMQ_DRAIN_DELAY_SECONDS=30
WORKER_SHUTDOWN_TIMEOUT_MS=20000
EXECUTION_RECONCILIATION_INTERVAL_MS=15000
NOTIFICATION_RECONCILIATION_INTERVAL_MS=15000
INTERNAL_EVENT_POLL_INTERVAL_MS=5000
DEMO_TELEMETRY_INTERVAL_MS=60000
METRICS_ENABLED=false

# Required application secrets. Generate independent random values >= 32 bytes.
JWT_ACCESS_SECRET=replace-in-secret-store
JWT_REFRESH_SECRET=replace-in-secret-store
SESSION_IP_HASH_PEPPER=replace-in-secret-store
WEBHOOK_TOKEN_PEPPER=replace-in-secret-store
SECRET_ENCRYPTION_KEY=replace-in-secret-store
CONNECTION_ENCRYPTION_KEY=base64:replace-with-exactly-32-random-bytes

# Seed input. Do not expose this value to the browser bundle.
FLOWMIND_DEMO_EMAIL=demo@example.com
FLOWMIND_DEMO_PASSWORD=replace-in-operator-environment

# Operator assertions used by the deployment preflight.
FLOWMIND_UPSTASH_EVICTION_DISABLED=true
RENDER_API_KEY=replace-in-operator-environment
VERCEL_TOKEN=replace-in-operator-environment
VERCEL_ORG_ID=replace-with-existing-user-or-team-id
VERCEL_PROJECT_ID=replace-with-existing-project-id

# Required only after reviewing `deploy:demo-free:plan`.
# FLOWMIND_SECOND_GATE_APPROVED=DEPLOY_FLOWMIND_DEMO_FREE
