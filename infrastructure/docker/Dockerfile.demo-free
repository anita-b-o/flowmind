FROM node:22-bookworm-slim AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --filter @automation/demo-runtime... --frozen-lockfile
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
RUN pnpm --filter @automation/api prisma:generate
RUN pnpm --filter @automation/demo-runtime... build
RUN pnpm --filter @automation/demo-runtime deploy --prod /prod/demo-runtime
RUN prisma_source="$(find /app/node_modules/.pnpm -path '*/node_modules/.prisma/client' -type d | head -n 1)" \
  && prisma_target="$(find /prod/demo-runtime/node_modules/.pnpm -path '*/node_modules/.prisma/client' -type d | head -n 1)" \
  && test -n "$prisma_source" \
  && test -n "$prisma_target" \
  && cp -a "$prisma_source/." "$prisma_target/"

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=build /prod/demo-runtime /app

EXPOSE 3001
CMD ["node", "dist/main.js"]
